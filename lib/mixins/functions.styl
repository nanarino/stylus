/**
 * 转为 css native oklch
 *
 * @example oklch(0.58 0.2 25 \/ .5) => `oklch(0.58 0.2 25/0.5)`
 */
oklch(color)
    s('oklch(%s)', color)

/**
 * 覆盖 stylus 的 selector
 * @override selector(':is()') => `selector(:is())`
 *
 * 不要省略not的括号 css支持 但是stylus不支持
 * 如 css`@supports not selector(:is(a, b))` 
 * 要写成 styl`@supports not (selector(:is(a, b))`
 * 
 */
selector(query_str)
    s('selector(%s)', unquote(query_str))

/**
 * 定義 path 函式
 * 
 * 刪除冗餘的縮進 需要用 '\\' 來換行
 * 事實上 即使沒有這個函式 也需要用 '\\' 來換行
 */
path(path_str)
    s('path(%s)', replace("\\\s+", "", path_str))

/**
 * 获取拼接的css变量
 *
 * name: str | var
 * level: int | var
 * return: str
 */
_get_var_by(property, level = none)
    if  level == none
        '--%s'%(unquote(property))
    else
        '--%s-%s'%(unquote(property) level)

/**
 * 保留小数点后 3 位（避免浅档 chroma 被四舍五入成 0）
 */
_round3(n)
    round(n * 1000) / 1000

/**
 * [0,1] → [0,1] 对数缓出：log10(1+k·t) / log10(1+k)
 * k 越大近 0 爬升越快（峰更尖）；越小峰更宽
 */
_log_ease(t, k = 9)
    math(1 + k * t, 'log') / math(1 + k, 'log')

/**
 * OKLCH Lightness：level 1~10，单条对数曲线（浅色区更密）
 * light: 浅→深用缓入；dark: 深→浅用缓出
 */
_get_lightness_by(theme, level, gray = false)
    t = (level - 1) / 9
    span = gray ? 0.79 : 0.77
    u = theme == 'dark' ? _log_ease(t) : 1 - _log_ease(1 - t)
    base = theme == 'dark' ? 0.18 : 0.97
    sign = theme == 'dark' ? 1 : -1
    _round3(base + sign * u * span)

/**
 * OKLCH Chroma：相对 level 6 连续对数衰减；gray 恒为 0
 * /10 + 小 k：拉近 5/6/7，避免 primary-5 像禁用
 */
_get_chroma_by(theme, level, gray = false)
    if gray
        0
    else
        peak = theme == 'dark' ? 0.24 : 0.28
        d = abs(level - 6) / 10
        _round3(peak * (1 - _log_ease(d, 3)))

/**
 * 多行省略混入
 */
mixin_line_clamp(number)
    display -webkit-box
    -webkit-box-orient vertical
    -webkit-line-clamp number
    overflow hidden
