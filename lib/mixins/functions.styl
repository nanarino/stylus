/**
 * 转为 css native oklch
 *
 * @example oklch(0.58 0.2 25 \/ .5) => `oklch(0.58 0.2 25/0.5)`
 */
oklch(color)
    s('oklch(%s)', color)

/**
 * 覆盖 stylus 的 selector
 * @override selector(':is()') => `selector(:is())`
 *
 * 不要省略not的括号 css支持 但是stylus不支持
 * 如 css`@supports not selector(:is(a, b))` 
 * 要写成 styl`@supports not (selector(:is(a, b))`
 * 
 */
selector(query_str)
    s('selector(%s)', unquote(query_str))

/**
 * 定義 path 函式
 * 
 * 刪除冗餘的縮進 需要用 '\\' 來換行
 * 事實上 即使沒有這個函式 也需要用 '\\' 來換行
 */
path(path_str)
    s('path(%s)', replace("\\\s+", "", path_str))

/**
 * 获取拼接的css变量
 *
 * name: str | var
 * level: int | var
 * return: str
 */
_get_var_by(property, level = none)
    if  level == none
        '--%s'%(unquote(property))
    else
        '--%s-%s'%(unquote(property) level)

/**
 * 保留小数点后 2 位
 */
_round2(n)
    round(n * 100) / 100

/**
 * OKLCH Lightness：level 1~10
 * light: 浅→深；dark: 深→浅
 */
_get_lightness_by(theme, level, gray = false)
    t = (level - 1) / 9
    if theme == 'dark'
        _round2(0.18 + t * 0.77)
    else
        _round2(0.97 - t * (gray ? 0.79 : 0.77))

/**
 * OKLCH Chroma：level 6 达峰，向两端线性衰减；gray 恒为 0
 * 峰值略抬高、衰减放缓，便于 yellow/gold 在统一曲线下够艳
 */
_get_chroma_by(theme, level, gray = false)
    if gray
        0
    else
        peak = theme == 'dark' ? 0.24 : 0.28
        _round2(peak * (1 - abs(level - 6) / 8))

/**
 * 多行省略混入
 */
mixin_line_clamp(number)
    display -webkit-box
    -webkit-box-orient vertical
    -webkit-line-clamp number
    overflow hidden
