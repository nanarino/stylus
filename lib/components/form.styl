.{prefix}-form-item
    display flex
    gap 8px
    margin-bottom 16px
    align-items center
    &:where(label)
        width fit-content
    &:where([data-inline])
        display inline-flex

.{prefix}-form-item-message
    // visibility hidden
    color oklch(var(--primary-6))
    position absolute
    left 0
    bottom -1.5em
    font-size var(--font-size-base)
    line-height var(--line-height-base)

.{prefix}-input-wrapper:where([data-validate])
    &:where(:has(:focus:invalid))
        {_get_var_by('hue', 'primary')} var(_get_var_by('hue', 'danger'))
        mixin_primary_channels()
    &:where(:not(:has(:focus:invalid)))
        .{prefix}-form-item-message
            visibility hidden
