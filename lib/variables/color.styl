:root
    background oklch(var(--white))
    color oklch(var(--black))
:root, :root[data-theme=light]
    --white 1 0 0
    --black 0 0 0
    color-scheme light
:root[data-theme=dark]
    --white 0 0 0
    --black 1 0 0
    color-scheme dark
/**
 * @desc OKLCH 色板：同 L/C 曲线，仅 hue 区分色相
 *
 * token：`--red-6: L C H`
 * 使用：`oklch(var(--red-6))` / `oklch(var(--red-6) / .5)`
 *
 * light: 1 最浅 → 10 最深；dark: 1 最深 → 10 最浅
 */
color_hues = {
    red: 25,
    orange: 55,
    gold: 80,
    yellow: 95,
    lime: 125,
    green: 145,
    cyan: 200,
    blue: 255,
    purple: 300,
    pinkpurple: 325,
    magenta: 350
}

:root, :root[data-theme=light]
    for name, hue in color_hues
        for i in 1..10
            {_get_var_by(name, i)} _get_lightness_by('light', i) _get_chroma_by('light', i) hue
    for i in 1..10
        {_get_var_by('gray', i)} _get_lightness_by('light', i, true) 0 0

:root[data-theme=dark]
    for name, hue in color_hues
        for i in 1..10
            {_get_var_by(name, i)} _get_lightness_by('dark', i) _get_chroma_by('dark', i) hue
    for i in 1..10
        {_get_var_by('gray', i)} _get_lightness_by('dark', i, true) 0 0
